rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions: সিকিউরিটি যাচাইয়ের জন্য
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // Default deny all: নিরাপত্তার স্বার্থে অনির্ধারিত সব কালেকশন ডিফল্টভাবে ব্লক
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Products: সাধারণ ভিজিটর প্রোডাক্ট দেখতে ও ক্লিক কাউন্ট বাড়াতে পারবে; অ্যাডমিন পণ্য যোগ/এডিট/ডিলিট করবে
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'updatedAt'])
      );
    }

    // 2. Banners: ব্যানার সবাই দেখতে পারবে, অ্যাডমিন পরিবর্তন করবে
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Categories: ক্যাটাগরি সবাই দেখতে পারবে, অ্যাডমিন পরিবর্তন করবে
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Settings: স্টোর সেটিংস সবাই দেখতে পারবে, অ্যাডমিন সেভ করবে
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Ads: বিজ্ঞাপন সবাই দেখতে পারবে, অ্যাডমিন পরিবর্তন করবে
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Login Logs:
    // - যেকোনো ডিভাইস থেকে লগইন হিস্টোরি তৈরি (Create) হতে পারবে
    // - পাসওয়ার্ড সংক্রান্ত সেনসিটিভ তথ্য ফায়ারবেসে প্রবেশ সম্পূর্ণ নিষিদ্ধ ও ফিল্টার্ড
    // - অ্যাডমিন প্যানেলে রিয়েল-টাইমে প্রদর্শন (read) ও ক্লিয়ার (delete) করা যাবে
    match /login_logs/{logId} {
      allow create: if !('password' in request.resource.data) 
                    && !('enteredPassword' in request.resource.data) 
                    && !('wrongPassword' in request.resource.data)
                    && !('plainPassword' in request.resource.data)
                    && request.resource.data.status in ['success', 'failed', 'blocked'];
      allow read, delete: if true;
      allow update: if isAdmin();
    }

    // 7. Blocked Devices:
    // - যেকোনো ডিভাইস ব্লক স্ট্যাটাস যাচাই করতে পারবে
    // - অ্যাডমিন প্যানেল থেকে ব্লক ও আনব্লক (delete) সারা বিশ্বের সব ডিভাইসে তাৎক্ষণিকভাবে কার্যকর হবে
    match /blocked_devices/{deviceId} {
      allow read, write: if true;
    }

    // 8. Admin Whitelist / Auth Records
    match /admins/{uid} {
      allow read, write: if isSignedIn();
    }
  }
}
