rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: Public can read all active products, Admins have full access
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin() && isValidId(productId);
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'updatedAt'])
      );
    }

    // Banners collection
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ads collection: Public can read active ads, Admins have full access
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blocked devices collection: public read so blocked devices can be immediately identified, write by admin
    match /blocked_devices/{deviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Login logs collection: create allowed for recording login attempts, read/update/delete by admin
    match /login_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin authorization whitelist
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
  }
}

