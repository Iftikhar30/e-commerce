rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------
    // HELPER FUNCTIONS & ROLE-BASED ACCESS CONTROL (RBAC)
    // ----------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Secure Admin Authorization:
    // 1. Strictly UID-based: checks if request.auth.uid exists in /admins/{uid}.
    // 2. Zero hardcoded emails or secrets in rules.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default Deny: Catch-all block on any unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Products: Public catalog reading & affiliate click tracking
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'updatedAt'])
      );
    }

    // 2. Promotional Banners: Public read, Admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Categories: Public read, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Storefront Settings: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Ad Placements: Public read, Admin write
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Login Logs:
    // - Read / List / Delete are STRICTLY restricted to Admin (Zero public log scraping).
    // - Create is allowed for Admin OR strictly validated sanitized login attempt records with ZERO passwords.
    //   All login events are captured through the trusted Vercel Serverless API using Firebase Admin SDK.
    // - Update is completely denied (immutable audit log).
    match /login_logs/{logId} {
      allow read, list, delete: if isAdmin();
      allow update: if false;
      allow create: if isAdmin() || (
        isValidId(logId) &&
        request.resource.data.id == logId &&
        request.resource.data.status in ['success', 'failed', 'blocked'] &&
        request.resource.data.email is string && request.resource.data.email.size() <= 120 &&
        !('password' in request.resource.data) &&
        !('enteredPassword' in request.resource.data) &&
        !('wrongPassword' in request.resource.data) &&
        !('plainPassword' in request.resource.data) &&
        !('passwordAttempt' in request.resource.data)
      );
    }

    // 7. Blocked Devices:
    // - Visitors can ONLY query/listen to their own single document (get by deviceId),
    //   preventing leakage/scraping of other blocked users.
    // - List / Create / Update / Delete are strictly Admin-only.
    match /blocked_devices/{deviceId} {
      allow get: if isValidId(deviceId);
      allow list, create, update, delete: if isAdmin();
    }

    // 8. Admin Whitelist:
    // - Authenticated users can check if their own UID is registered, and Admins can list.
    // - Writing is denied to all client users (preventing self-promotion/privilege escalation).
    // - Master admin documents are securely created in Firebase Console.
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
