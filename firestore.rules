rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ifti30ahmed@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection
    match /products/{productId} {
      // Public can read active products. Admin can read all (including hidden).
      allow get: if (resource.data.active == true) || isAdmin();
      allow list: if (resource.data.active == true) || isAdmin();

      // Admin has full CRUD
      allow create: if isAdmin() && isValidId(productId);
      allow delete: if isAdmin();

      // Updates: Admin can update any field; Public can ONLY atomically increment clickCount by 1
      allow update: if isAdmin() || (
        resource.data.active == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) &&
        request.resource.data.clickCount == resource.data.clickCount + 1
      );
    }

    // Banners collection
    match /banners/{bannerId} {
      // Public can read active banners. Admin can read all.
      allow get: if (resource.data.active == true) || isAdmin();
      allow list: if (resource.data.active == true) || isAdmin();

      allow create: if isAdmin() && isValidId(bannerId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      // Public can read active categories. Admin can read all.
      allow get: if (resource.data.active == true) || isAdmin();
      allow list: if (resource.data.active == true) || isAdmin();

      allow create: if isAdmin() && isValidId(categoryId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin authorization whitelist collection
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
