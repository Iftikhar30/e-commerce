rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Products: সাধারণ ভিজিটররা দেখতে পারবে, ক্লিক কাউন্ট বাড়াতে পারবে; অ্যাডমিন ফুল কন্ট্রোল পাবে
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount', 'updatedAt'])
      );
    }

    // 2. Banners: ব্যানার সবাই পড়তে পারবে, অ্যাডমিন তৈরি/এডিট/ডিলিট করবে
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Categories: ক্যাটাগরি সবাই পড়তে পারবে, অ্যাডমিন তৈরি/এডিট/ডিলিট করবে
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Settings: স্টোর কনফিগারেশন সবাই পড়তে পারবে, অ্যাডমিন আপডেট করবে
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Ads: বিজ্ঞাপন ও পপআপ ব্যানার সবাই পড়তে পারবে, অ্যাডমিন ম্যানেজ করবে
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Login Logs: 
    // - যেকোনো ডিভাইস থেকে লগইন চেষ্টা রেকর্ড (Create) করা যাবে (পাসওয়ার্ড ছাড়া ও নির্দিষ্ট ফিল্ড ভ্যালিডেশন সহ)
    // - সাধারণ ভিজিটর কখনোই অন্য কারো লগ পড়তে (Read/List) বা পরিবর্তন করতে পারবে না
    // - শুধুমাত্র অ্যাডমিন সমস্ত লগইন হিস্টোরি পড়তে ও ম্যানেজ করতে পারবে
    match /login_logs/{logId} {
      allow create: if !('password' in request.resource.data) 
                    && !('enteredPassword' in request.resource.data) 
                    && !('wrongPassword' in request.resource.data)
                    && !('plainPassword' in request.resource.data)
                    && request.resource.data.status in ['success', 'failed', 'blocked'];
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 7. Blocked Devices:
    // - যে কোনো ডিভাইস শুধু নিজের আইডি দিয়ে ব্লক চেক (get) করতে পারবে
    // - পুরো তালিকা খোঁজা (list) বা কাউকে ব্লক/আনব্লক করার ক্ষমতা শুধু অ্যাডমিনের থাকবে
    match /blocked_devices/{deviceId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 8. Admin Whitelist: শুধুমাত্র অথেনটিকেটেড ইউজাররা অ্যাডমিন রেকর্ড পড়তে/লিখতে পারবে
    match /admins/{uid} {
      allow read, write: if isSignedIn();
    }
  }
}
