# Firebase Configuration for Amazon Product Discovery / Affiliate Storefront
# Obtain these values from your Firebase Project Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini API Key for Auto-fetching Product Details (Title, Multiple Images, Price, Rating, Reviews)
GEMINI_API_KEY=
